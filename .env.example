# Banco de Dados Relacional PostgreSQL (Supabase, Neon, AWS RDS ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cocktailbiz?schema=public"

# Ambiente de Execução
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gateway de Pagamento Mercado Pago (Pessoa Física - CPF ou PJ)
# Obtenha em https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxx-xxxxxx-xxxxxx"
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxxxxxx-xxxxxx-xxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="seu_token_secreto_webhook"
